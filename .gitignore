# ============================================================
# InvoiceX — Root Git Ignore
# ============================================================

# ----------------------------
# Environment variables / secrets
# ----------------------------
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Certificates, private keys and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/
secrets.json
credentials.json
service-account*.json

# ----------------------------
# Python / Django backend
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# Python packaging
build/
dist/
.eggs/
*.egg
*.egg-info/
wheels/
pip-wheel-metadata/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
nosetests.xml
test-results/

# Type checking / linting caches
.mypy_cache/
.pyright/
.ruff_cache/
.dmypy.json
.pyre/

# Django local files
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3-journal
media/
staticfiles/

# ----------------------------
# React / Vite / Node frontend
# ----------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
dist/
build/

# Vite caches
.vite/
frontend/.vite/

# Framework / tool caches
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.svelte-kit/

# Package manager logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------
# Rust blockchain service
# ----------------------------
target/
blockchain/target/

# Rust generated binaries
*.rlib
*.rmeta

# Local ledger data — never commit runtime state
ledger-data/
ledger-data.json
ledger.json
blockchain/data/
blockchain/*.db
blockchain/*.sqlite
blockchain/*.sqlite3

# ----------------------------
# PostgreSQL / database exports
# ----------------------------
*.dump
*.sql.gz
*.backup
*.bak

# Keep intentional, sanitized database scripts tracked.
# Do not put migrations or schema definitions here.

# ----------------------------
# Logs and temporary files
# ----------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*.orig
*.rej

# ----------------------------
# IDEs and editors
# ----------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates

# ----------------------------
# Operating system files
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ----------------------------
# Local environment / tooling
# ----------------------------
.python-version.local
.npmrc.local
.pnpm-store/
.yarn/
.yarnrc.yml.local

# ----------------------------
# Generated reports / artifacts
# ----------------------------
*.prof
*.profraw
*.coverage
report.html
playwright-report/
test-results/
storybook-static/

# ----------------------------
# Optional local-only project files
# ----------------------------
*.local
*.local.*
